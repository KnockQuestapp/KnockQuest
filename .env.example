# Copy this file to .env and fill with real values.
# Never commit real credentials.

APP_ENV=development
APP_NAME=KnockQuest
APP_FLAVOR=production

# Maps provider settings
MAP_PROVIDER=osm
GOOGLE_MAPS_API_KEY=replace_with_google_maps_key_if_enabled

# Backend/API settings
API_BASE_URL=https://api.example.com
API_TIMEOUT_SECONDS=30

# Auth
JWT_AUDIENCE=knockquest
JWT_ISSUER=knockquest-auth
